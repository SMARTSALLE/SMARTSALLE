# SmartSalle ISPITS — modele de variables d'environnement.
#
# ATTENTION : ce fichier ne contient AUCUN secret. Les vraies valeurs vivent
# dans Infisical (https://infisical.com), plus dans un .env sur le disque.
#
# Utilisation :
#   1. Importer ce fichier dans Infisical (glisser-deposer sur la page
#      Secrets Overview) puis remplacer les valeurs par les vraies.
#   2. Lancer l'application :  infisical run --env=dev -- node server/index.js
#      (ou simplement `npm start`, deja enveloppe).
#
# Sans valeur definie, l'application retombe sur ses valeurs par defaut
# (visibles dans server/index.js et server/db.js).

# --- Serveur HTTP ---
PORT=3000
HOST=0.0.0.0
# Mettre 1 pour tracer chaque requete dans la console.
LOG_REQUESTS=0
# 'production' desactive l'affichage local des codes de verification email.
NODE_ENV=development

# --- Base de donnees SQLite persistante ---
SMARTSALLE_DB=./data/smartsalle.db

# --- Compte administration cree au premier demarrage ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Envoi d'emails (code de verification, mot de passe, notifications) ---
# L'hote, le port, l'utilisateur et le chiffrement (STARTTLS/SMTPS) se
# configurent dans la page "Parametres" de l'application (table `settings`).
# Le MOT DE PASSE SMTP est un secret : il se met ici (donc dans Infisical) et
# n'est jamais stocke en base ni renvoye par l'API.
# Tant que SMTP_HOST est vide dans Parametres, aucun email n'est reellement
# envoye : les messages sont ecrits dans data/outbox/ (boite locale de dev).
SMTP_PASSWORD=
